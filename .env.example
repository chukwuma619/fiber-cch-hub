# =============================================================================
# Fiber CCH Hub — copy this file to .env and edit the passwords below.
#
#   cp .env.example .env
#
# Full walkthrough: docs/GETTING-STARTED.md
# =============================================================================

# Docker images (usually leave as-is)
FIBER_IMAGE=nervos/fiber:0.9.0
LND_IMAGE=lightninglabs/lnd:v0.18.5-beta

# REQUIRED — pick strong passwords and keep them secret.
# FIBER_SECRET_KEY_PASSWORD unlocks the Fiber/CCH container key material.
# LND_WALLET_PASSWORD unlocks your Lightning wallet.
FIBER_SECRET_KEY_PASSWORD=change-me-fiber-cch-hub
LND_WALLET_PASSWORD=change-me-lnd

# Host ports (change only if something else already uses these ports)
FIBER_P2P_PORT=8228
FIBER_RPC_PORT=8227
CCH_RPC_PORT=8327
LND_RPC_PORT=10009
LND_P2P_PORT=9735

# Docker Compose project name (affects container names)
COMPOSE_PROJECT_NAME=fiber-cch-hub

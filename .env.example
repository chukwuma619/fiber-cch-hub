# Fiber CCH Hub — pinned Docker runtime
#
# Official image: https://hub.docker.com/r/nervos/fiber
# Docs: https://github.com/nervosnetwork/fiber/blob/develop/docker/README.md

FIBER_IMAGE=nervos/fiber:v0.9.0

# Shared password for container entrypoint (required by docker-entrypoint.sh).
# Change this. Do not commit real secrets.
FIBER_SECRET_KEY_PASSWORD=change-me-fiber-cch-hub

# Host ports
FIBER_P2P_PORT=8228
FIBER_RPC_PORT=8227
CCH_RPC_PORT=8327

# Compose project name
COMPOSE_PROJECT_NAME=fiber-cch-hub

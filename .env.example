# Password for encrypting your CKB wallet key (data/fiber/ckb/key).
# Required — set before: make create-keys
FIBER_SECRET_KEY_PASSWORD=change-me

# Unlocks your Lightning wallet (created by make create-keys).
LND_WALLET_PASSWORD=change-me

# Docker images (usually leave as-is)
FIBER_IMAGE=nervos/fiber:0.9.0
LND_IMAGE=lightninglabs/lnd:v0.18.5-beta

# Host ports
FIBER_P2P_PORT=8228
FIBER_RPC_PORT=8227
CCH_RPC_PORT=8327
LND_RPC_PORT=10009
LND_P2P_PORT=9735

COMPOSE_PROJECT_NAME=fiber-cch-hub
